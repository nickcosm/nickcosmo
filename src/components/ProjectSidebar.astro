---
import { getCollection } from 'astro:content';
import Header from './Header.astro';

const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<div class="flex-1 scheme-dark md:overflow-y-auto border-r border-r-mist-700" transition:persist="project-sidebar">
	<div class="page-content">
		<Header />
		<div class="grid grid-cols-12 gap-x-4 m-4">
			<div class="col-span-0 md:col-span-4"></div>
			<div class="col-span-12 md:col-span-8 mb-8">
				<h2>Ethical Designer & Developer</h2>
				<p>I use deep systems thinking—understanding the full stack from server to browser. I focus on keeping sites fast, accessible, cheap to host, and easy for non-technical owners to update.
				Recent work has focused on remediating accessibility issues, modernizing legacy codebases and increasing performance in CMS-based websites, improving WCAG compliance and overall user experience.</p>
			</div>
		</div>
		<nav class="project-nav hidden md:block" aria-label="Project navigation">
			<div class="grid grid-cols-12 gap-x-4 m-4 border-b border-b-mist-700">
				<div class="col-span-4 md:col-span-4">Client</div>
				<div class="col-span-8 md:col-span-8">Project</div>
			</div>
			{projects.map((project) => (
				<a href={`/projects/${project.id}`} class="block">
					<div class="grid grid-cols-12 gap-x-4 m-4 border-b border-b-mist-700 pb-4">
						<div class="col-span-4 md:col-span-4"><h2>{project.data.client}</h2></div>
						<div class="col-span-8 md:col-span-8"><h2>{project.data.title}</h2></div>
					</div>
				</a>
			))}
		</nav>
	</div>
</div>
