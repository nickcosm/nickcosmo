---
import { getEntry, render } from 'astro:content';
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';

const slug = Astro.params.slug;
const page = slug ? await getEntry('pages', slug) : undefined;
const Content = page ? (await render(page)).Content : undefined;

if (!page) {
  Astro.response.status = 404;
}
---
<html lang="en">
  <head>
    <Head />
    <title>{page ? page.data.title : 'Page not found'} / Nick Cosmo</title>
  </head>
  <body class="dark">
    <Header />
    <main id="main-content" class="pb-16">
      <div class="content grid grid-cols-8 gap-x-4 m-4">
					<div class="col-span-8 md:col-span-2 mt-2">
            {page && Content ? (
              <>
                <h1>{page.data.title}</h1>
                <Content />
              </>
            ) : (
              <h1>Page not found</h1>
            )}
          </div>
      </div>
    </main>
  </body>
</html>
