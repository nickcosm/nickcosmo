---
import { getEntry, render } from 'astro:content';
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';

const slug = Astro.params.slug;
const page = slug ? await getEntry('pages', slug) : undefined;
const Content = page ? (await render(page)).Content : undefined;

if (!page) {
  Astro.response.status = 404;
}
---
<html lang="en">
  <head>
    <Head />
    <title>{page ? page.data.title : 'Page not found'} / Nick Cosmo</title>
  </head>
  <body class="dark md:flex md:h-dvh md:flex-col">
    <Header />
    <main id="main-content" class="pb-16 md:flex md:min-h-0 md:flex-1 md:flex-col">
      <div class="content grid grid-cols-8 gap-x-4 m-4 md:min-h-0 md:flex-1 md:grid-rows-[1fr]">
					<div class="col-span-8 md:col-span-4 mt-2 md:min-h-0 md:overflow-y-auto">
            {page && Content ? (
              <>
                <h1>{page.data.title}</h1>
                </>
            ) : (
              <h1>Page not found</h1>
            )}
          </div>
            <div class="page-content col-span-8 md:col-span-4 mt-2 md:min-h-0 md:overflow-y-auto">
              {page && Content ? (
              <Content />
              ) : (
              <p>Content not available</p>
              )}
            </div>  
          </div>
      </div>
    </main>
  </body>
</html>
