---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Head from '../../components/Head.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const slug = Astro.params.slug;
const project = slug ? await getEntry('projects', slug) : undefined;
const Content = project ? (await render(project)).Content : undefined;

if (!project) {
  Astro.response.status = 404;
}
---
<html lang="en">
	<head>
		<Head />
		<title>{project ? project.data.title : 'Project not found'} / Nick Cosmo</title>
	</head>
	<body class="dark">
		<Header />
			<main id="main-content" class="pb-16">
				<div class="content grid grid-cols-8 gap-x-4 m-4">
					<div class="col-span-8 md:col-span-2 mt-2">
					{project && Content ? (
						<>
						<h1>{project.data.title}</h1>
						{project.data.cover && <Image 
						src={project.data.cover} 
						alt={project.data.coverAlt ?? `Cover image for ${project.data.title}`} />}
						<Content />
						</>
					) : (
						<h1>Project not found</h1>
					)}
					</div>
				</div>
			</main>
		<Footer />
	</body>
</html>