---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Head from '../../components/Head.astro';
import Header from '../../components/Header.astro';

const slug = Astro.params.slug;
const project = slug ? await getEntry('projects', slug) : undefined;
const Content = project ? (await render(project)).Content : undefined;

if (!project) {
  Astro.response.status = 404;
}
---
<html lang="en">
	<head>
		<Head />
		<title>{project ? project.data.title : 'Project not found'} / Nick Cosmo</title>
	</head>
	<body class="dark md:flex md:h-dvh md:flex-col">
		<Header />
			<main id="main-content" class="pb-16 md:flex md:min-h-0 md:flex-1 md:flex-col">
				<div class="content grid grid-cols-8 gap-x-4 m-4 md:min-h-0 md:flex-1 md:grid-rows-[1fr]">
					<div class="col-span-8 md:col-span-4 mt-2 md:min-h-0 scheme-dark md:overflow-y-auto">
					{project && Content ? (
						<>
						
						{project.data.cover && <Image 
						src={project.data.cover} 
						alt={project.data.coverAlt ?? `Cover image for ${project.data.title}`} />}
						
						</>
					) : (
						<h1>Project not found</h1>
					)}
					</div>
					<div class="project-content col-span-8 md:col-span-4 mt-2 md:min-h-0 scheme-dark md:overflow-y-auto">
					{project && Content ? (
						<h1>{project.data.title}</h1>
						<Content />
					) : (
						<p>Content not available</p>
					)}
					</div>
				</div>
			</main>
	</body>
</html>