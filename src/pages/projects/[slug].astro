---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import ProjectLayout from '../../layouts/ProjectLayout.astro';

const slug = Astro.params.slug;
const project = slug ? await getEntry('projects', slug) : undefined;
const Content = project ? (await render(project)).Content : undefined;
if (!project) {
  Astro.response.status = 404;
}
---
<ProjectLayout title={`${project ? project.data.title : 'Project not found'} / Nick Cosmo`}>
	
	{project && Content ? (
		<article class="content project-content m-4 border-b border-b-mist-700">
			<div class="grid grid-cols-12 gap-x-4 pb-2 my-4 border-b border-b-mist-700">
				<div class="col-span-4 md:col-span-4">{project.data.client}</div>
				<div class="col-span-6 md:col-span-6">{project.data.title}</div>
				<div class="col-span-2 md:col-span-2">{project.data.year}</div>
			</div>
			{project.data.cover && (
				<Image
					src={project.data.cover}
					alt={project.data.coverAlt ?? `Cover image for ${project.data.title}`}
					widths={[480, 960, 1440]}
					sizes="(min-width: 768px) 50vw, 100vw"
					class="mb-2 h-auto w-full"
				/>
			)}
			<div class="grid grid-cols-12 gap-x-4 my-4">
				<div class="col-span-12 md:col-span-4">
					{(project.data.wcagAuditBefore || project.data.wcagAuditAfter) && (
					<div class="project-downloads">
						<ul>
						{project.data.wcagAuditBefore && (
							<li>
								<a href={project.data.wcagAuditBefore} download>
									Download WCAG audit before
								</a>
							</li>
						)}
						{project.data.wcagAuditAfter && (
							<li>
								<a href={project.data.wcagAuditAfter} download>
									Download WCAG audit after
								</a>
							</li>
						)}
					</ul>
					</div>
					)}
					{project.data.website && (
						<div class="project-website">
							<a href={project.data.website} target="_blank" rel="noopener noreferrer">
								Visit Website
							</a>
						</div>
					)}
				</div>
				<div class="col-span-12 md:col-span-8">
					<Content />
				</div>
			</div>
		</article>
		<div class="grid grid-cols-12 m-4 gap-x-4 my-4">
			<div class="col-span-12">
				<a href="/">Index</a>
			</div>
		</div>
	) : (
		<h1>Project not found</h1>
	)}
</ProjectLayout>